[Defines]
  DEC_SPECIFICATION              = 0x0001001a
  PACKAGE_NAME                   = H3Pkg
  PACKAGE_GUID                   = 5aa1bb1c-f8c5-4fd2-93e2-61b2dc012674
  PACKAGE_VERSION                = 0.1

################################################################################
#
# Include Section - list of Include Paths that are provided by this package.
#                   Comments are used for Keywords and Module Types.
#
# Supported Module Types:
#  BASE SEC PEI_CORE PEIM DXE_CORE DXE_DRIVER DXE_RUNTIME_DRIVER DXE_SMM_DRIVER DXE_SAL_DRIVER UEFI_DRIVER UEFI_APPLICATION
#
################################################################################
[Includes.common]
  Include                        # Root include for the package

[Guids.common]
  gH3PkgTokenSpaceGuid        = { 0x172e8bc2, 0xc793, 0x4df1, { 0xaa, 0x13, 0x67, 0xff, 0xd6, 0xbd, 0x8c, 0xae } }
  gSunxiTokenSpaceGuid        = { 0x61521ade, 0x87d6, 0x4fd3, { 0x98, 0x4e, 0x6f, 0x05, 0xef, 0x47, 0x98, 0xef } }

[Protocols]
  gGpioProtocolGuid           = { 0xac669f62, 0x88c9, 0x4f64, { 0xbe, 0xff, 0xc7, 0x80, 0xbf, 0x37, 0x1f, 0x53 } }

[PcdsFixedAtBuild.common]
  # Memory allocation
  gH3PkgTokenSpaceGuid.PcdUefiMemPoolBase|0|UINT64|0x00000a106
  gH3PkgTokenSpaceGuid.PcdUefiMemPoolSize|0|UINT32|0x00000a107

  # Sunxi Hardware
  gH3PkgTokenSpaceGuid.PcdSunxiUartBase|0x01C28000|UINT32|0x0000a200
  gH3PkgTokenSpaceGuid.PcdSunxiTimerBase|0x01C20C00|UINT32|0x0000a201

  # SMBIOS
  gH3PkgTokenSpaceGuid.PcdSmbiosSystemModel|"Orange Pi PC Plus"|VOID*|0x0000a300
  gH3PkgTokenSpaceGuid.PcdSmbiosSystemRetailModel|"sun8iw7p1"|VOID*|0x0000a301
  gH3PkgTokenSpaceGuid.PcdSmbiosProcessorModel|"sun8iw7p1"|VOID*|0x0000a302

  # Simple FrameBuffer (matches upstream U-Boot bdinfo: 0x7e000000, 1280x720x32)
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferAddress|0x7E000000|UINT32|0x0000a400
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferWidth|1280|UINT32|0x0000a401
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferHeight|720|UINT32|0x0000a402
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferPixelBpp|32|UINT32|0x0000a403
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferVisibleWidth|1280|UINT32|0x0000a404
  gH3PkgTokenSpaceGuid.PcdMipiFrameBufferVisibleHeight|720|UINT32|0x0000a405
